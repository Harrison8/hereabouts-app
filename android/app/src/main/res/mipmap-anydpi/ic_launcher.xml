<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher icon: the brand mark over its kraft-paper ground. The phone cuts the shape (circle, squircle) itself.
     The mark's letter is cut out, so the same image serves as the one-colour layer for themed icons. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground_inset" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground_inset" />
</adaptive-icon>
