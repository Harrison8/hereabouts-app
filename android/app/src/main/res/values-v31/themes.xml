<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later draw their own loading screen from these: kraft, with the moss tag shown 160 dp square in
     the middle of the screen, where the opening's first frame draws it. -->
<resources>
    <style name="Theme.Hereabouts.Launch" parent="Theme.Hereabouts">
        <item name="android:windowSplashScreenBackground">#ECE5D3</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_tag</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
